<?xml version="1.0" encoding="utf-8"?>
<!--
  前端 IIS 站点用：SPA 回退 + 将 /api、/healthz 反代到本机后端。
  依赖（缺任一都会导致站点 HTTP 500）：
    1) IIS URL Rewrite
    2) Application Request Routing (ARR)
    3) 服务器节点 → Application Request Routing Cache → Server Proxy Settings → 勾选 Enable proxy

  后端本机地址默认 http://127.0.0.1:8791（与阿里云 IIS 后端站点绑定一致时可直接用）。
  本文件位于 frontend/public/，构建后进入 dist/，随前端部署覆盖到站点根目录。

  SSE 流式（/api/chat/stream）注意：
    - 下方 location 对 /api 关闭动态压缩；压缩模块会攒满整个响应再发出，导致事件流被缓冲。
    - ARR 的响应缓冲与超时只能在服务器级配置（applicationHost.config，web.config 中不可覆盖），
      部署机上以管理员执行一次：
        %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/proxy /responseBufferLimit:"0" /timeout:"00:05:00" /commit:apphost
      responseBufferLimit=0 使 ARR 逐块转发；timeout 默认 120 秒，与后端 ChatEndpoint:Timeout 相同，
      多工具调用的长轮次会先被 ARR 断开（浏览器侧表现为 502 或流中途结束），因此应大于后端超时。
-->
<configuration>
  <location path="api">
    <system.webServer>
      <urlCompression doDynamicCompression="false" />
    </system.webServer>
  </location>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="CesiumAI API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8791/api/{R:1}" />
        </rule>
        <rule name="CesiumAI Healthz" stopProcessing="true">
          <match url="^healthz$" />
          <action type="Rewrite" url="http://127.0.0.1:8791/healthz" />
        </rule>
        <rule name="CesiumAI SPA" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
